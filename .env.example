# Copy to .env and change every value. Never commit .env.
POSTGRES_PASSWORD=change-me-local-db-password
# at least 32 characters, e.g.  openssl rand -base64 48
SMARTASSIGN_JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Secret code supervisors and handlers enter on the staff sign-up page (share it only with staff).
# Leave empty to disable staff sign-up. Customers can always sign up.
SMARTASSIGN_STAFF_REGISTRATION_CODE=change-me-staff-code
# A claim resolved within this many days of assignment counts as "on time" in a handler's success rate.
SMARTASSIGN_RESOLUTION_TARGET_DAYS=14
SMARTASSIGN_ML_ENABLED=true
